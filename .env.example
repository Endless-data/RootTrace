# 宿主机开发配置：配合 `docker compose up -d db` 和 `uv run flask --app app run` 使用。
SECRET_KEY=replace-with-a-long-random-development-secret
DATABASE_URL=postgresql+psycopg://roottrace@localhost:5433/roottrace

# 全容器 Compose 启动时，web 服务会在 compose.yaml 中使用容器内地址：
# postgresql+psycopg://roottrace@db:5432/roottrace
